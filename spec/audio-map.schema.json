{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.10.0/spec/audio-map.schema.json",
  "$comment": "Versioned, immutable release URL (git tag v2.10.0); 'main' carries the latest. See GOVERNANCE.md.",
  "title": "Genlock Audio Map",
  "description": "Per-project mapping of shot IDs to typed audio-track arrays. Stored at projects/{slug}/audio-map.json. Paths on disk are relative to the workspace root.",
  "type": "object",
  "required": ["version", "tracks"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "tracks": {
      "type": "object",
      "description": "Audio tracks keyed by shot ID.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/AudioTrack" }
      }
    }
  },
  "definitions": {
    "AudioTrack": {
      "type": "object",
      "required": ["id", "type", "path", "label", "volume"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["dialogue", "sfx", "music"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)" },
          "description": "Audio path relative to the workspace root."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "offsetSeconds": { "type": "number", "minimum": 0 },
        "fadeInSeconds": { "type": "number", "minimum": 0 },
        "fadeOutSeconds": { "type": "number", "minimum": 0 },
        "prompt": { "type": "string" },
        "model": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["imported", "generated", "seeaudio", "ai"]
        },
        "status": {
          "type": "string",
          "enum": ["generated", "review", "approved", "rejected", "superseded"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "provenance": { "$ref": "#/definitions/Provenance" },
        "extensions": {
          "type": "object",
          "propertyNames": { "pattern": "^x-" },
          "additionalProperties": true
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bone_id": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true },
        "generated_at": { "type": "string", "format": "date-time" },
        "job_id": { "type": "string" }
      }
    }
  }
}
