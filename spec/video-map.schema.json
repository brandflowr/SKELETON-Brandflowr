{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.10.0/spec/video-map.schema.json",
  "$comment": "Versioned, immutable release URL (git tag v2.10.0); 'main' carries the latest. See GOVERNANCE.md.",
  "title": "Genlock Video Map",
  "description": "Per-project mapping of shot IDs to video-take arrays. Stored at projects/{slug}/video-map.json. Paths on disk are relative to the workspace root.",
  "type": "object",
  "required": ["version", "takes"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "takes": {
      "type": "object",
      "description": "Video takes keyed by shot ID.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/VideoTake" }
      }
    }
  },
  "definitions": {
    "VideoTake": {
      "type": "object",
      "required": ["id", "path", "label", "isActive"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable take identifier. This is separate from the display label."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)" },
          "description": "Video path relative to the workspace root."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Display label such as V1 or V2."
        },
        "isActive": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": ["imported", "generated", "ai"]
        },
        "status": {
          "type": "string",
          "enum": ["generated", "review", "approved", "rejected", "superseded"]
        },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "fps": { "type": "number", "minimum": 0 },
        "replacesTakeId": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "prompt": { "type": "string" },
        "promptJson": {
          "type": "object",
          "additionalProperties": true
        },
        "promptTemplate": {
          "type": "object",
          "additionalProperties": true
        },
        "boneId": { "type": "string" },
        "model": { "type": "string" },
        "provenance": { "$ref": "#/definitions/Provenance" },
        "extensions": {
          "type": "object",
          "propertyNames": { "pattern": "^x-" },
          "additionalProperties": true
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bone_id": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true },
        "generated_at": { "type": "string", "format": "date-time" },
        "job_id": { "type": "string" }
      }
    }
  }
}
